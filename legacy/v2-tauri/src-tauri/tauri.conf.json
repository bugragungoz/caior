{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "croxz-runtimes",
  "version": "2.0.0",
  "identifier": "com.croxz.aio.runtimes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "croxz runtimes",
        "width": 980,
        "height": 680,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../assets/icon.ico", "../assets/icon.png"]
  }
}
